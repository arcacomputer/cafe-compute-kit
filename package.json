{
  "name": "cafe-compute-kit",
  "version": "0.1.0",
  "private": true,
  "description": "A bilingual community-event website and private feedback/benefit-distribution toolkit.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "workspaces": [
    "apps/event-site",
    "apps/feedback",
    "vercel/sender-project"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:vercel": "node vercel/build.mjs",
    "test:root": "node --max-old-space-size=512 --test --test-concurrency=1 tests/*.test.mjs",
    "test:unit": "npm run test:root && npm run test:unit --workspaces --if-present",
    "test:postgres": "npm run test:postgres --workspace @cafe-compute-kit/feedback",
    "test:worker": "node scripts/proof-worker.mjs",
    "test:browser": "npm run test:worker && npm run test:browser --workspace @cafe-compute-kit/feedback",
    "check:source": "node scripts/check-source.mjs",
    "preview": "node scripts/preview.mjs",
    "deploy": "wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@vercel/functions": "3.10.1"
  },
  "devDependencies": {
    "@vercel/build-utils": "14.22.0",
    "@vercel/node": "25.0.0",
    "axe-core": "4.14.0",
    "playwright": "1.64.1",
    "wrangler": "4.151.2"
  }
}
