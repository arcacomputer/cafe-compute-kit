{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"cafe-compute-kit-example",
 "main":"apps/feedback/worker.js",
 "compatibility_date":"2025-09-01",
 "workers_dev":false,"preview_urls":false,
 "assets":{"directory":"./dist","binding":"ASSETS","run_worker_first":true},
 "vars":{
  "PUBLIC_ORIGIN":"https://event.example.invalid",
  "EVENT_NAME":"Cafe Compute example event",
  "PROVIDER_NAME":"Example sponsor",
  "BENEFIT_DESCRIPTION":"Example only; replace with reviewed sponsor terms",
  "AUTH_ENABLED":"false","FEEDBACK_ENABLED":"false","MAGIC_EMAIL_ENABLED":"false",
  "CREDIT_CLAIMS_ENABLED":"false","REAL_CREDIT_DISTRIBUTION":"false",
  "PHOTOS_ENABLED":"false","PRIVATE_PHOTO_METADATA_ACK":"false",
  "CREDIT_LINK_ORIGINS":"https://credits.example.invalid"
 },
 "ratelimits":[{"name":"FEEDBACK_RATE","namespace_id":"1001","simple":{"limit":100,"period":60}}]
 // Choose your own Worker name, canonical origin, domain route and unique numeric
 // rate-limit namespace before deploying. Add only YOUR deliberately provisioned
 // private service/R2 bindings; see docs/deployment.md. Secrets never belong here.
}